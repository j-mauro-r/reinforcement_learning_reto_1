      "source": "def _md_table(headers, rows):\n    def esc(value):\n        return str(value).replace(\"|\", \\"\\|\\")\n    lines = [\"| \" + \" | \".join(headers) + \" |\", \"| \" + \" | \".join([\"---\"] * len(headers)) + \" |\"]\n    lines.extend(\"| \" + \" | \".join(esc(value) for value in row) + \" |\" for row in rows)\n    return \"\\n\".join(lines)\n\ndef _fmt(value, digits=4):\n    if isinstance(value, float):\n        return f\"{value:.{digits}f}\"\n    return value\n\nhyperparameters = {\n    \"Learning rate\": config[\"agent\"][\"learning_rate\"],\n    \"Gamma\": config[\"agent\"][\"gamma\"],\n    \"Batch size\": config[\"replay_buffer\"][\"batch_size\"],\n    \"Replay Buffer capacity\": config[\"replay_buffer\"][\"capacity\"],\n    \"Learning starts\": config[\"training\"][\"learning_starts\"],\n    \"Train frequency\": config[\"training\"][\"train_frequency\"],\n    \"Target update frequency\": config[\"training\"][\"target_update_frequency\"],\n    \"Epsilon start\": config[\"agent\"][\"epsilon_start\"],\n    \"Epsilon final\": config[\"agent\"][\"epsilon_final\"],\n    \"Epsilon decay steps\": config[\"training\"][\"epsilon_decay_steps\"],\n    \"Total timesteps\": config[\"training\"][\"total_timesteps\"],\n}\n\ndisplay(Markdown(\"#### Configuración experimental\\n\" + _md_table([\"Parámetro\", \"Valor\"], [(k, _fmt(v)) for k, v in hyperparameters.items()])))\n\nruntime_rows = [\n    (\"Python\", runtime_info.get(\"python_version\")),\n    (\"Gymnasium\", runtime_info.get(\"gymnasium_version\")),\n    (\"ALE-Py\", runtime_info.get(\"ale_py_version\")),\n    (\"PyTorch\", runtime_info.get(\"torch_version\")),\n    (\"CUDA\", runtime_info.get(\"cuda_version\")),\n    (\"GPU entrenamiento\", training_hardware_for_report.get(\"gpu\")),\n    (\"VRAM runtime actual (GB)\", runtime_info.get(\"gpu_vram_total_gb\")),\n    (\"RAM runtime actual (GB)\", runtime_info.get(\"ram_total_gb\")),\n    (\"Git SHA ejecutado\", bootstrap.resolved_sha),\n]\ndisplay(Markdown(\"#### Librerías, hardware y trazabilidad\\n\" + _md_table([\"Elemento\", \"Valor\"], runtime_rows)))\n\ntraining_rows = [\n    (\"Timesteps finales\", training_summary_for_report.get(\"global_step\", training_summary_for_report.get(\"final_global_step\"))),\n    (\"Episodios completados\", training_summary_for_report.get(\"episodes_completed\")),\n    (\"Updates DDQN\", training_summary_for_report.get(\"updates_count\")),\n    (\"Replay Buffer final\", training_summary_for_report.get(\"final_replay_buffer_size\")),\n    (\"Epsilon final\", training_summary_for_report.get(\"epsilon_final\")),\n    (\"Loss media\", _fmt(training_summary_for_report.get(\"mean_loss\"))),\n    (\"Loss final\", _fmt(training_summary_for_report.get(\"last_loss\"))),\n    (\"Q mean promedio\", _fmt(training_summary_for_report.get(\"mean_q_mean\"))),\n    (\"Q mean final\", _fmt(training_summary_for_report.get(\"last_q_mean\"))),\n    (\"Tiempo entrenamiento (s)\", _fmt(training_summary_for_report.get(\"duration_seconds\"), 2)),\n    (\"Tiempo entrenamiento (min)\", _fmt(float(training_summary_for_report.get(\"duration_seconds\")) / 60.0, 2)),\n]\ndisplay(Markdown(\"#### Resultado del entrenamiento\\n\" + _md_table([\"Métrica\", \"Valor\"], training_rows)))\n\nepisode_rows = [\n    (index + 1, FINAL_EVAL_SEEDS[index], compact_evaluation_summary.rewards[index], compact_evaluation_summary.episode_lengths[index])\n    for index in range(compact_evaluation_summary.episodes)\n]\ndisplay(Markdown(\"#### Evaluación final por episodio\\n\" + _md_table([\"Episodio\", \"Seed\", \"Reward\", \"Steps\"], episode_rows)))\n\nstatistics_rows = [\n    (\"N episodios\", compact_evaluation_summary.episodes),\n    (\"Epsilon\", compact_evaluation_summary.epsilon),\n    (\"Mean reward\", _fmt(compact_evaluation_summary.mean_reward, 2)),\n    (\"Median reward\", _fmt(compact_evaluation_summary.median_reward, 2)),\n    (\"Std reward\", _fmt(compact_evaluation_summary.std_reward, 2)),\n    (\"Min reward\", _fmt(compact_evaluation_summary.min_reward, 2)),\n    (\"Max reward\", _fmt(compact_evaluation_summary.max_reward, 2)),\n]\ndisplay(Markdown(\"#### Estadísticas de explotación\\n\" + _md_table([\"Estadística\", \"Valor\"], statistics_rows)))\n\ncomparison_rows = [\n    (\"Baseline aleatorio\", _fmt(random_baseline.mean_reward, 2)),\n    (\"DDQN modelo compacto\", _fmt(compact_evaluation_summary.mean_reward, 2)),\n    (\"Mejora absoluta\", _fmt(baseline_comparison.absolute_improvement, 2)),\n    (\"Mejora relativa\", f\"{baseline_comparison.relative_improvement_pct:.2f}%\"),\n]\ndisplay(Markdown(\"#### Comparación cuantitativa contra baseline\\n\" + _md_table([\"Métrica\", \"Reward\"], comparison_rows)))\n\nfigure_by_id = {spec.figure_id: spec for spec in training_figures}\nreward_spec = figure_by_id[\"reward\"]\nloss_spec = figure_by_id[\"loss\"]\nq_spec = figure_by_id[\"q_mean_epsilon\"]\nreward_mean_series = reward_spec.series[\"episode/reward_mean\"]\nloss_smooth_series = loss_spec.series[\"train/loss_smooth\"]\nq_series = q_spec.series[\"train/q_mean\"]\nepsilon_series = q_spec.series[\"train/epsilon\"]\ncurve_analysis = (\n    f\"**Análisis de las curvas.** La media móvil de recompensa pasa de {reward_mean_series.values[0]:.2f} a {reward_mean_series.values[-1]:.2f} entre los primeros y últimos registros disponibles. \"\n    f\"La loss suavizada pasa de {loss_smooth_series.values[0]:.4f} a {loss_smooth_series.values[-1]:.4f}; se interpreta junto con reward y Q-values, no de forma aislada. \"\n    f\"El q_mean evoluciona de {q_series.values[0]:.4f} a {q_series.values[-1]:.4f}, mientras epsilon desciende de {epsilon_series.values[0]:.4f} a {epsilon_series.values[-1]:.4f}, consistente con la transición gradual de exploración hacia explotación.\"\n)\ndisplay(Markdown(curve_analysis))\n\nif baseline_comparison.agent_beats_random:\n    conclusion = (\n        f\"**Conclusión basada en evidencia.** El modelo compacto DDQN obtiene una recompensa promedio de **{compact_evaluation_summary.mean_reward:.2f}** en {compact_evaluation_summary.episodes} episodios independientes, \"\n        f\"frente a **{random_baseline.mean_reward:.2f}** del baseline aleatorio. La mejora es de **{baseline_comparison.absolute_improvement:.2f} puntos** (**{baseline_comparison.relative_improvement_pct:.2f}%**). \"\n        f\"Bajo el presupuesto de {config['training']['total_timesteps']} timesteps, la seed principal disponible y la stochasticity de ALE, la evidencia soporta que DDQN aprendió una política superior a la aleatoria para Assault. \"\n        \"Este resultado no demuestra optimalidad global ni generalización a múltiples seeds de entrenamiento.\"\n    )\nelse:\n    conclusion = (\n        f\"**Conclusión basada en evidencia.** El modelo compacto DDQN obtiene {compact_evaluation_summary.mean_reward:.2f}, frente a {random_baseline.mean_reward:.2f} del baseline aleatorio. \"\n        \"La evidencia disponible no permite afirmar superioridad sobre la política aleatoria; por tanto el criterio interno de desempeño no se considera satisfecho.\"\n    )\ndisplay(Markdown(conclusion))\n\nprint(\"HIPERPARAMETERS=\", hyperparameters)\nprint(\"RUNTIME_INFO=\", runtime_info)\nprint(\"TRAINING_EVIDENCE=\", training_summary_for_report)\nprint(\"FINAL_EVALUATION=\", compact_evaluation_summary.as_dict())\nprint(\"BASELINE=\", random_baseline.as_dict())\nprint(\"COMPARISON=\", baseline_comparison.as_dict())\n"
    },
